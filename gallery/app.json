{
  "expo": {
    "name": "UI kit",
    "slug": "ui-kit-gallery",
    "scheme": "uikitgallery",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true },
    "plugins": ["expo-router", "expo-font", "expo-image", "expo-status-bar", "expo-splash-screen"],
    "experiments": { "typedRoutes": false }
  }
}
